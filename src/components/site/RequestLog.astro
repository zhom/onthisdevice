---
/**
 * A live list of the requests this page has made and the hosts they went to, read from the
 * browser's resource timing. It shows that the page talks to this site only.
 */
---

<div data-requests class="min-w-0">
  <p class="t-h2 text-foreground">
    <span class="num" data-req-total>0</span> requests from this page
  </p>
  <p class="mt-2 text-[0.9375rem] text-muted-foreground">
    <span class="num" data-req-self>0</span> to <span data-req-host>onthisdevice.com</span>, <span class="num" data-req-other>0</span> to other servers. The list grows as you search or open a tool.
  </p>
  <ol class="mt-6 space-y-1.5 font-mono text-[0.8125rem]" data-req-list aria-label="Latest requests"></ol>
  <noscript><p class="mt-6 text-[0.9375rem] text-muted-foreground">Turn on JavaScript to see the list.</p></noscript>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-requests]')
  if (root) {
    const total = root.querySelector('[data-req-total]')
    const self = root.querySelector('[data-req-self]')
    const other = root.querySelector('[data-req-other]')
    const list = root.querySelector('[data-req-list]')
    const host = root.querySelector('[data-req-host]')
    if (host) host.textContent = location.host
    const SHOWN = 6
    let own = 1 // the page itself
    let foreign = 0
    const rows: { path: string; size: number }[] = []
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

    const render = (fresh: number) => {
      if (total) total.textContent = String(own + foreign)
      if (self) self.textContent = String(own)
      if (other) other.textContent = String(foreign)
      if (!list) return
      list.replaceChildren(
        ...rows.slice(-SHOWN).map((r, i, shown) => {
          const li = document.createElement('li')
          li.className = 'flex min-w-0 justify-between gap-4'
          const path = document.createElement('span')
          path.className = 'truncate text-foreground'
          path.textContent = r.path
          const size = document.createElement('span')
          size.className = 'num shrink-0 text-muted-foreground'
          size.textContent = r.size > 0 ? `${Math.max(1, Math.round(r.size / 1024))} KB` : 'cached'
          li.append(path, size)
          if (!reduce && i >= shown.length - fresh) li.animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 260, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' })
          return li
        }),
      )
    }

    const add = (entries: PerformanceEntryList) => {
      let fresh = 0
      for (const e of entries) {
        let url: URL
        try {
          url = new URL(e.name)
        } catch {
          continue
        }
        if (url.protocol !== 'http:' && url.protocol !== 'https:') continue
        if (url.origin === location.origin) own++
        else foreign++
        rows.push({ path: url.origin === location.origin ? url.pathname : url.host + url.pathname, size: (e as PerformanceResourceTiming).transferSize ?? 0 })
        fresh++
      }
      if (fresh) render(Math.min(fresh, SHOWN))
    }

    add(performance.getEntriesByType('resource'))
    try {
      new PerformanceObserver((list) => add(list.getEntries())).observe({ type: 'resource' })
    } catch {
      // Old browsers: the counts stay as they were at load.
    }
  }
</script>
