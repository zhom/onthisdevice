---
/** The home hero's pixel page (motion in hero-field.ts). Decorative. */
import { cn } from '@/lib/utils'

interface Props {
  class?: string
}
const { class: className } = Astro.props
---

<div class={cn('hero-field relative text-foreground select-none', className)} data-hero-field aria-hidden="true">
  <canvas class="absolute inset-0 block size-full"></canvas>
</div>

<script>
  import { mountHeroField } from './hero-field'
  for (const host of document.querySelectorAll<HTMLElement>('[data-hero-field]')) mountHeroField(host)
</script>
