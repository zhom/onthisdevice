---
/** See hero-redact.ts. A grid sibling of the hero columns, so it can use the full width. */
---

<script is:inline>
  try {
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !sessionStorage.getItem('otd:hero')) {
      sessionStorage.setItem('otd:hero', '1')
      document.documentElement.dataset.heroIntro = 'run'
    }
  } catch {}
</script>

<p class="hero-sentence" data-hero-sentence aria-hidden="true"><span data-keep>Your</span> <span data-keep>files</span> <span class="cut">go</span> <span class="cut">to</span> <span class="cut">a</span> <span class="cut">server,</span> <span class="cut">where</span> <span class="cut">they</span> <span data-keep>stay</span> <span class="cut">for</span> <span class="cut">a</span> <span class="cut">day</span> <span data-keep>on</span> <span class="cut">a</span> <span class="cut">free</span> <span class="cut">plan</span> <span class="cut">that</span> <span class="cut">limits</span> <span data-keep>this</span> <span data-keep>device</span> <span class="cut">to</span> <span class="cut">three</span> <span class="cut">files</span><span data-keep>.</span></p>

<script>
  import { mountHeroRedact } from './hero-redact'
  mountHeroRedact()
</script>

<style is:global>
  .hero-sentence {
    display: none;
  }
  [data-hero-intro] .hero-sentence {
    display: block;
    grid-column: 1 / -1;
    grid-row: 1;
    z-index: 1;
    font-weight: 760;
    font-size: clamp(1.25rem, 0.55rem + 2.9vw, 3rem);
    line-height: 1.12;
    color: var(--foreground);
    pointer-events: none;
    animation: hero-out 0s 8s forwards;
  }
  .hero-sentence [data-keep],
  .hero-sentence .cut,
  [data-hero-title] [data-word] {
    display: inline-block;
    line-height: 1;
    transform-origin: 0 0;
  }
  .hero-sentence .cut {
    position: relative;
    transition: opacity 260ms var(--ease-out);
  }
  .hero-sentence .cut::after {
    content: '';
    position: absolute;
    inset: 0.06em -0.04em -0.03em;
    background: var(--foreground);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 150ms var(--ease-out);
  }
  .hero-sentence .cut.on::after {
    transform: none;
  }
  .hero-sentence .cut.on {
    color: transparent;
    transition:
      color 0s 150ms,
      opacity 260ms var(--ease-out);
  }
  .hero-sentence.closing .cut {
    opacity: 0;
  }
  /* The heading stays in the accessibility tree. The guards end the intro if the script never runs. */
  @keyframes hero-guard {
    to {
      opacity: 1;
    }
  }
  @keyframes hero-out {
    to {
      visibility: hidden;
    }
  }
  [data-hero-intro] [data-hero-title],
  [data-hero-intro] [data-hero-field] {
    opacity: 0;
    animation: hero-guard 0s 8s forwards;
  }
  [data-hero-field] {
    transition: opacity 480ms var(--ease-out);
  }
</style>
