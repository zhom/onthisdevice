---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Container from '@/components/site/Container.astro'
import Glyph from '@/components/site/Glyph.astro'
import Icon from '@/components/site/Icon.tsx'
import HeroHeading from '@/components/site/reel/HeroHeading.astro'
import HeroReel from '@/components/site/reel/HeroReel.astro'
import HeroSearch from '@/components/site/search/HeroSearch.tsx'
import PickFile from '@/components/site/search/PickFile.astro'
import { CATEGORIES, GROUPS, TOOL_COUNT_TEXT, categoryHref, getTool, toolsByCategory, type Tool } from '@/lib/tools'
import { PAID, QUICK } from '@/lib/featured'
import { hasPage } from '@/components/site/pages'

const pick = (slugs: string[]) => slugs.map((s) => getTool(s)).filter((t): t is Tool => t !== undefined && hasPage(t))
const quick = pick(QUICK)
const paid = PAID.flatMap((p) => pick([p.slug]).map((tool) => ({ tool, gives: p.gives })))

let glyphIndex = 0
const catalogue = GROUPS.map((g) => ({
  group: g,
  categories: CATEGORIES.filter((c) => c.group === g.id).map((c) => ({
    category: c,
    count: toolsByCategory(c.id).filter(hasPage).length,
    // Glyphs in the list change one after another, not all at once.
    offset: (glyphIndex++ * 0.42) % 7.2,
  })).filter((c) => c.count > 0),
})).filter((g) => g.categories.length > 0)

const title = `onthisdevice: ${TOOL_COUNT_TEXT} free tools that never upload your files`
const description = `Remove backgrounds, transcribe audio, upscale photos and edit PDFs for free. ${TOOL_COUNT_TEXT} tools, AI models included, run in your browser. Nothing is uploaded.`

const faqs: { q: string; a: string }[] = [
  {
    q: 'Are my files really never uploaded?',
    a: 'Yes. Each tool runs in your browser and does the work on your device. The site has no server that could receive your file, so nothing is sent anywhere.',
  },
  {
    q: 'How can this be free?',
    a: 'There is almost nothing to pay for. The site is a set of static files, and the work runs on your computer. Upload services pay for every file they process, which is why they meter you.',
  },
  {
    q: 'Do the tools work offline?',
    a: 'A tool keeps working after its page and its engine have loaded, also with the network off. Video tools get a 10 MB engine from this site the first time; your browser keeps it.',
  },
  {
    q: 'What are the limits?',
    a: 'There is no daily quota. Each tool shows its file limit: about 200 MB for images, 300 to 800 MB for most PDF tools and 1 to 4 GB for video. Your device sets the speed.',
  },
  {
    q: 'Do you use cookies, analytics or ads?',
    a: 'No. The site has no cookies, analytics, trackers or ads. Your browser keeps your theme, the tools you opened, some tool settings and cached code on your device. None of it is sent anywhere.',
  },
]

const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': 'https://onthisdevice.com/#page',
    url: 'https://onthisdevice.com/',
    name: title,
    description,
    isPartOf: { '@id': 'https://onthisdevice.com/#website' },
  },
  {
    '@type': 'FAQPage',
    '@id': 'https://onthisdevice.com/#faq',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
]
---

<BaseLayout title={title} description={description} canonicalPath="/" jsonLd={jsonLd}>
  <section class="relative lg:flex lg:min-h-[min(48rem,calc(100svh-4rem))] lg:items-center" aria-labelledby="hero-title">
    <Container class="relative z-10 pt-8 sm:pt-14 lg:pointer-events-none lg:py-20">
      <div class="min-w-0 lg:pointer-events-auto lg:w-[48%]">
        <HeroHeading />
        <p class="t-lead enter mt-6 max-w-[34rem]" style="--i:1" data-og-line={`${TOOL_COUNT_TEXT} free tools that run in your browser. Nothing is uploaded.`}>
          {TOOL_COUNT_TEXT} free tools for PDFs, photos, video, audio and calculations. They work in your browser, so your files stay with you. No sign-up, no watermark.
        </p>

        <div class="enter mt-9 flex max-w-[36rem] flex-col gap-3 sm:flex-row" style="--i:2">
          <div class="relative z-10 min-w-0 flex-1">
            <HeroSearch client:load />
          </div>
          <PickFile />
        </div>
        <p class="enter mt-3 hidden max-w-[36rem] text-[0.9375rem] text-muted-foreground pointer-fine:block" style="--i:3">Or drop a file anywhere on this page.</p>

        <ul class="enter mt-6 flex max-w-[36rem] flex-wrap items-baseline gap-x-5 gap-y-2" aria-label="Popular tools" style="--i:4">
          <li aria-hidden="true" class="text-[0.9375rem] text-muted-foreground">Popular:</li>
          {
            quick.map((tool) => (
              <li>
                <a href={`/${tool.slug}`} class="link text-[0.9375rem] font-[560]">
                  {tool.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </Container>

    <HeroReel class="enter mt-4 sm:mt-10 lg:mt-0" />
  </section>

  <Container class="pt-20 sm:pt-32">
    <section aria-labelledby="paid-title">
      <div class="grid grid-cols-1 gap-x-16 gap-y-5 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
        <h2 id="paid-title" class="t-title max-w-[16ch] text-foreground">Tools that other sites charge for.</h2>
        <p class="t-lead max-w-[34rem] lg:pt-2">Upload sites pay for each file they process, so they sell credits and plans. Here your device does the work, so there is nothing to meter.</p>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-x-8 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
        {
          paid.map(({ tool, gives }) => (
            <a href={`/${tool.slug}`} class="row-link group items-center">
              <span class="grid size-10 place-items-center text-foreground">
                <Icon name={tool.icon} className="size-6" strokeWidth={1.5} />
              </span>
              <span class="min-w-0">
                <span class="block text-[1.0625rem] font-[680] text-foreground">{tool.title}</span>
                <span class="mt-0.5 block truncate text-[0.875rem] text-muted-foreground">{gives}</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </Container>

  <Container class="pt-24 sm:pt-40">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="t-h2 text-foreground">Everything else</h2>
      <a href="/all-tools" class="link text-[0.9375rem] font-[600]">All {TOOL_COUNT_TEXT} tools</a>
    </div>
    <div class="mt-8 space-y-12">
      {
        catalogue.map(({ group, categories }) => (
          <section aria-labelledby={`g-${group.id}`}>
            <h3 id={`g-${group.id}`} class="text-[0.9375rem] font-[600] text-muted-foreground">
              {group.title}
            </h3>
            <div class="mt-3 grid grid-cols-1 gap-x-8 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
              {categories.map(({ category, count, offset }) => (
                <a href={categoryHref(category)} class="row-link group items-center">
                  <Glyph id={category.id} offset={offset} class="size-10 text-foreground" />
                  <span class="min-w-0">
                    <span class="flex items-baseline gap-2">
                      <span class="text-[1.0625rem] font-[680] text-foreground">{category.title}</span>
                      <span class="num text-[0.875rem] text-muted-foreground">{count}</span>
                    </span>
                    <span class="mt-0.5 block truncate text-[0.875rem] text-muted-foreground">{category.tagline}</span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </Container>

  <Container class="pt-24 sm:pt-32">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
      <div>
        <h2 class="t-h2 text-foreground">Questions</h2>
        <p class="mt-3 max-w-sm text-[1rem] leading-relaxed text-muted-foreground">
          The <a href="/privacy" class="link font-[600]">privacy page</a> lists what the site stores and what it never sees.
        </p>
      </div>
      <div class="max-w-3xl">
        {
          faqs.map((faq) => (
            <details class="faq">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 rounded-md py-4 text-[1.0625rem] font-[620] text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 [&::-webkit-details-marker]:hidden">
                <span class="text-pretty">{faq.q}</span>
                <span class="faq-mark mt-0.5 grid size-5 shrink-0 place-items-center">
                  <Icon name="Plus" className="size-5" />
                </span>
              </summary>
              <p class="max-w-2xl pb-5 text-[1rem] leading-relaxed text-pretty text-muted-foreground">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </Container>

  <Container class="pt-24 pb-8 sm:pt-40 sm:pb-16">
    <h2 class="t-display max-w-[14ch] text-foreground">What do you need to do?</h2>
    <div class="relative z-10 mt-8 max-w-[34rem]">
      <HeroSearch client:visible />
    </div>
  </Container>
</BaseLayout>
