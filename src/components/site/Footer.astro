---
import { CATEGORIES, GROUPS, TOOL_COUNT, categoryHref, toolsByCategory } from '@/lib/tools'
import Container from './Container.astro'
import Wordmark from './Wordmark.astro'

const year = new Date().getFullYear()

const columns = GROUPS.map((group) => ({
  ...group,
  categories: CATEGORIES.filter((c) => c.group === group.id).map((c) => ({
    ...c,
    href: categoryHref(c),
    count: toolsByCategory(c.id).length,
  })),
})).filter((g) => g.categories.length > 0)
---

<footer class="mt-28 bg-muted sm:mt-36">
  <Container class="pt-14 pb-[max(2.5rem,env(safe-area-inset-bottom))] sm:pt-20">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16">
      <div>
        <a href="/" aria-label="onthisdevice, home" class="inline-block rounded-md focus-visible:outline-2 focus-visible:outline-offset-4">
          <Wordmark size="lg" />
        </a>
        <p class="mt-5 max-w-xs text-[0.9375rem] leading-relaxed text-pretty text-muted-foreground">
          {TOOL_COUNT} tools that run in your browser. The site has no accounts and no analytics.
        </p>
        <p class="mt-6 text-[0.8125rem] leading-snug text-muted-foreground">Every page is sent with this rule:</p>
        <code class="mt-1.5 block font-mono text-[0.8125rem] break-words text-foreground">connect-src 'self' blob: data:</code>
        <p class="mt-1.5 max-w-xs text-[0.8125rem] leading-snug text-muted-foreground">
          Your browser does not let a page here connect to another server.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 xl:grid-cols-6">
        {
          columns.map((group) => (
            <nav aria-label={group.title}>
              <h2 class="text-[0.8125rem] font-[650] text-foreground">{group.title}</h2>
              <ul class="mt-3 space-y-2">
                {group.categories.map((cat) => (
                  <li>
                    <a href={cat.href} class="link-quiet text-[0.875rem]">
                      {cat.title}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="mt-16 flex flex-col-reverse gap-4 text-[0.8125rem] text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} onthisdevice.com</p>
      <nav aria-label="Site" class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {
          [
            ['/all-tools', 'All tools'],
            ['/about', 'About'],
            ['/privacy', 'Privacy'],
            ['/licenses/README.txt', 'Licences'],
          ].map(([href, label]) => (
            <a href={href} class="link-quiet">
              {label}
            </a>
          ))
        }
      </nav>
    </div>
  </Container>
</footer>
