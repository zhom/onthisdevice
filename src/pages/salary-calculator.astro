          <tr><td>18</td><td style="text-align:right">720</td><td style="text-align:right">1,440</td><td style="text-align:right">3,120</td><td style="text-align:right">37,440</td></tr>
          <tr><td>20</td><td style="text-align:right">800</td><td style="text-align:right">1,600</td><td style="text-align:right">3,467</td><td style="text-align:right">41,600</td></tr>
          <tr><td>25</td><td style="text-align:right">1,000</td><td style="text-align:right">2,000</td><td style="text-align:right">4,333</td><td style="text-align:right">52,000</td></tr>
          <tr><td>30</td><td style="text-align:right">1,200</td><td style="text-align:right">2,400</td><td style="text-align:right">5,200</td><td style="text-align:right">62,400</td></tr>
          <tr><td>35</td><td style="text-align:right">1,400</td><td style="text-align:right">2,800</td><td style="text-align:right">6,067</td><td style="text-align:right">72,800</td></tr>
          <tr><td>40</td><td style="text-align:right">1,600</td><td style="text-align:right">3,200</td><td style="text-align:right">6,933</td><td style="text-align:right">83,200</td></tr>
          <tr><td>50</td><td style="text-align:right">2,000</td><td style="text-align:right">4,000</td><td style="text-align:right">8,667</td><td style="text-align:right">104,000</td></tr>
          <tr><td>75</td><td style="text-align:right">3,000</td><td style="text-align:right">6,000</td><td style="text-align:right">13,000</td><td style="text-align:right">156,000</td></tr>
          <tr><td>100</td><td style="text-align:right">4,000</td><td style="text-align:right">8,000</td><td style="text-align:right">17,333</td><td style="text-align:right">208,000</td></tr>
        </tbody>
      </table>
    </div>

    <h2>Annual to hourly, at 2,080 hours</h2>
    <div class="overflow-x-auto">
