# =============================================================================
# onthisdevice.com: HTTP headers
# Cloudflare static assets apply these rules to every response.
# =============================================================================

# -----------------------------------------------------------------------------
# Every response: security headers and the Content-Security-Policy.
# -----------------------------------------------------------------------------
# Permissions-Policy: an empty allowlist `feature=()` blocks the feature for
# this origin too. Camera, microphone and screen capture are `(self)` because
# webcam-test, microphone-test, voice-recorder and screen-recorder are tools.
#
# Content-Security-Policy:
# script-src 'wasm-unsafe-eval' is required to compile WebAssembly (codecs,
#   FFmpeg) and is narrower than 'unsafe-eval'; blob: is for the ffmpeg and
#   pdf.js workers; 'unsafe-inline' covers inline JSON-LD and two snippets.
# connect-src 'self' blob: data: deliberately names no other origin. This is
#   the product promise in one line: a page here cannot send your data to any
#   other server. A change that needs another host here is wrong.
# No COOP/COEP: the single-threaded FFmpeg core needs no SharedArrayBuffer.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: accelerometer=(), autoplay=(self), browsing-topics=(), camera=(self), display-capture=(self), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(self), usb=(), xr-spatial-tracking=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: data:; manifest-src 'self'; upgrade-insecure-requests

# -----------------------------------------------------------------------------
# Long-lived assets. /_astro/ files carry a content hash; the FFmpeg core sits
# in a folder named for its version. Both are safe to cache for a year.
# -----------------------------------------------------------------------------
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/ffmpeg/*
  Cache-Control: public, max-age=31536000, immutable

# Data files sit in a folder named for their content hash (scripts/data).
/data/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=2592000

/og/*
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=604800

# The service worker must always be fetched fresh, or a deploy could never
# replace it.
/sw.js
  Cache-Control: no-cache

/search-index.json
  Cache-Control: public, max-age=3600

/sitemap*
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
